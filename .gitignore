# .gitignore base — evita versionar deps, segredos e cruft
# (a maior causa de anexo de GB nos seus projetos foi versionar/zipar isto)

# Segredos (NUNCA versione o .env real — só o exemplo)
.env
.env.local
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.pub
id_ed25519
credentials.json
service-account*.json
.npmrc
.pypirc
.aws/
session_secret

# Cruft / temporários
*.bak
*.tmp
*.orig
*.old
.fuse_hidden*
.DS_Store
Thumbs.db

# --- Python (perfil dados) ---
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
*.sqlite
*.db
# dados grandes/derivados (versione só os *.example e os curados pequenos)
open-data/
*.npy

# --- Node / Next (perfil web) ---
node_modules/
.next/
dist/
build/
*.tsbuildinfo
npm-debug.log*

# Backups (versione a ROTINA de backup, não os arquivos)
backups/
*.backup

# --- Obsidian ---
# a CONFIG do vault é versionada de propósito (o kit abre pronto);
# o estado de sessão, nao: muda a cada abertura e polui todo diff
.obsidian/workspace.json
.obsidian/workspace-mobile.json
